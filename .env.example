# ---------------------------------------------------------------------------
# EcoStruxure Light — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust values for your environment.
# `.env` is git-ignored and must never be committed.
#
# Variables are read by django-environ (see config/settings/base.py).

# Which settings module to load.
#   config.settings.development  (default for manage.py)
#   config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# Cryptographic signing key. Generate a fresh one for each environment:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-generate-a-real-key

# Debug toggle. NEVER enable in production.
DEBUG=True

# Comma-separated list of allowed hosts (required when DEBUG=False).
ALLOWED_HOSTS=localhost,127.0.0.1

# Default time zone.
TIME_ZONE=UTC

# --- Database --------------------------------------------------------------
# Development defaults to SQLite when DATABASE_URL is unset.
# To use PostgreSQL (required in production), set a URL such as:
#   DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/ecostruxure_light
# DATABASE_URL=

# --- Production-only --------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
