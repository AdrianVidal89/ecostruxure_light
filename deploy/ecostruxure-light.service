# systemd unit for the Gunicorn application server.
# Install on each VM:
#   sudo cp deploy/ecostruxure-light.service /etc/systemd/system/ecostruxure-light.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ecostruxure-light
#   sudo systemctl status ecostruxure-light
#
# Identical on PRD and PPRD — the difference between environments lives in the
# checked-out git branch and the .env file, not here.

[Unit]
Description=EcoStruxure Light — Gunicorn (Django/WSGI)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=OSPUser
Group=www-data
WorkingDirectory=/home/OSPUser/EcostruxureLight
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/home/OSPUser/EcostruxureLight/venv/bin/gunicorn \
          --access-logfile - \
          --error-logfile - \
          --workers 3 \
          --bind unix:/home/OSPUser/EcostruxureLight/app.sock \
          config.wsgi:application
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
