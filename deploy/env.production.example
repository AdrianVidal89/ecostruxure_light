# ---------------------------------------------------------------------------
# EcoStruxure Light — PRODUCTION / PRE-PRODUCTION environment file
# ---------------------------------------------------------------------------
# Copy this to `.env` IN THE REPO ROOT on the VM (NOT inside deploy/):
#     cp deploy/env.production.example .env
# then edit the values below. `.env` is git-ignored and must never be committed.
#
# This file documents every variable production needs. Adjust per VM.

# Use the production settings module. (gunicorn already defaults to this via
# config/wsgi.py; deploy.sh and systemd also export it for manage.py commands.)
DJANGO_SETTINGS_MODULE=config.settings.production

# Generate a UNIQUE key per environment (do NOT reuse between PRD and PPRD):
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=__PASTE_A_FRESH_GENERATED_KEY__

DEBUG=False

# This VM's IP / hostname. PRD = 10.144.15.61 · PPRD = 10.144.72.20
# Add the machine hostname too if you have one.
ALLOWED_HOSTS=10.144.15.61

TIME_ZONE=Europe/Madrid

# --- Database (PostgreSQL on the dedicated data disk, reached over localhost) -
# Format: postgres://USER:PASSWORD@127.0.0.1:5432/DBNAME
DATABASE_URL=postgres://ecx_app:__DB_PASSWORD__@127.0.0.1:5432/ecostruxure_light

# Seconds to keep a DB connection alive for reuse across requests. 60 is a good
# default for dozens of users. Set 0 to disable persistent connections.
DB_CONN_MAX_AGE=60

# --- Transport security ----------------------------------------------------
# We start on plain HTTP, so these stay OFF (otherwise login breaks).
# When you put TLS in front, set all of these and add the https origin below.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Needed for POST/login over the IP. Use the scheme you actually serve.
CSRF_TRUSTED_ORIGINS=http://10.144.15.61
