# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Django ---
*.log
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/
/backups/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# Database dumps. These carry real data — accounts_user password hashes,
# django_session keys, and every customer's POC content — so they must never
# be committed, no matter how convenient it is to move one between machines.
# Use the in-app Backup page (core:db_backup) or scp instead.
*.dump
*.sql
*.sql.gz

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Local tooling (not needed on the servers) ---
.claude/
*.code-workspace

# --- Claude/graphify local artifacts ---
/CLAUDE.md
/graphify-out/
# Playwright MCP scratch output (screenshots/snapshots from debugging sessions).
/.playwright-mcp/
